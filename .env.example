# Keep real values in a local .env file (ignored by Git) and Vercel Environment Variables.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=https://your-production-domain.example
# Optional if Google sign-in is enabled:
GOOGLE_CLIENT_ID=
