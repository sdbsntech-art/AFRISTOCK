# MySQL local (Laragon / Wamp / Xampp)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=afristock
MYSQL_POOL_SIZE=10

# Production/Vercel : URL privée d'une base MySQL hébergée (ne jamais utiliser localhost).
# Exemple de format uniquement : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:3306/BASE
MYSQL_URL=
# TLS est activé automatiquement pour les hôtes distants. Pour un certificat privé :
MYSQL_SSL_CA=
# Sur Vercel, laissez MYSQL_POOL_SIZE à sa valeur par défaut (1 connexion par instance).

PORT=3001
HOST=127.0.0.1
SESSION_SECRET=remplacer-par-une-cle-aleatoire-de-32-octets-minimum

# Origines autorisées (séparées par des virgules) pour la protection CSRF.
# En local : http://localhost:5173
# En production sur Vercel : laissez vide (l'application est monorigine).
APP_ORIGIN=http://localhost:5173

GOOGLE_CLIENT_ID=
